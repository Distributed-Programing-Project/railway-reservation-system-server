<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.iuh.fit.client.controller.EmployeeManagementController"
      spacing="10"
      prefWidth="1100"
      prefHeight="700">

    <!-- Header -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="20">
        <Label text="Quản Lý Nhân Viên" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAdd" text="+ Thêm nhân viên"
                styleClass="add-button" onAction="#handleAdd"/>
    </HBox>

    <!-- Filter bar -->
    <HBox styleClass="filter-bar" spacing="12" alignment="CENTER_LEFT">
        <padding><Insets top="4" bottom="4"/></padding>
        <Label text="Trạng thái:" styleClass="field-label"/>
        <ComboBox fx:id="statusFilter" styleClass="filter-combo" prefWidth="180"/>
        <Button text="Làm mới" styleClass="secondary-button" onAction="#handleRefresh"/>
    </HBox>

    <!-- TableView -->
    <TableView fx:id="tableView" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode"       text="Mã NV"        prefWidth="80"/>
            <TableColumn fx:id="colName"       text="Họ tên"       prefWidth="170"/>
            <TableColumn fx:id="colNationalId" text="CCCD"         prefWidth="120"/>
            <TableColumn fx:id="colPhone"      text="SĐT"          prefWidth="110"/>
            <TableColumn fx:id="colEmail"      text="Email"        prefWidth="200"/>
            <TableColumn fx:id="colType"       text="Loại"         prefWidth="100"/>
            <TableColumn fx:id="colStatus"     text="Trạng thái"   prefWidth="110"/>
            <TableColumn fx:id="colActions"    text="Thao tác"     prefWidth="270"/>
        </columns>
    </TableView>

    <!-- Pagination -->
    <HBox styleClass="pagination-bar" alignment="CENTER" spacing="20">
        <Button fx:id="btnPrev" text="◄" styleClass="secondary-button" onAction="#handlePrevPage"/>
        <Label fx:id="pageLabel" text="1 / 1" styleClass="page-label"/>
        <Button fx:id="btnNext" text="►" styleClass="secondary-button" onAction="#handleNextPage"/>
    </HBox>

    <!-- Loading overlay -->
    <StackPane fx:id="loadingOverlay" visible="false" styleClass="loading-overlay"
               VBox.vgrow="ALWAYS" maxHeight="-Infinity" minHeight="-Infinity">
        <VBox alignment="CENTER" spacing="12" styleClass="loading-container">
            <ProgressIndicator prefWidth="48" prefHeight="48"/>
            <Label text="Đang tải..." styleClass="field-label"/>
        </VBox>
    </StackPane>

</VBox>
